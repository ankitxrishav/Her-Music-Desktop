# Her Music — AppImage desktop entry.
# Same identity as her_music.desktop, but Exec is the bare binary name:
# inside the AppImage the executable lives at $APPDIR/usr/bin and there
# is no /opt/her_music (that absolute path belongs to the deb/rpm layout).
# Used ONLY by the CI AppImage step; see .github/workflows/desktop.yml.
[Desktop Entry]
Name=Her Music
Comment=Desktop music player — YouTube Music, lossless audio, Last.fm scrobbling
Exec=her_music_desktop
Icon=her_music
Terminal=false
Type=Application
Categories=Audio;Music;AudioVideo;
StartupWMClass=her_music_desktop
